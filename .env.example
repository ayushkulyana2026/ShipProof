# Copy to .env.local for local development. All values are optional:
# without them the audit still works; the backend endpoints answer 503
# (in development an in-memory store is used when DATABASE_URL is unset).

# Postgres connection string (Neon, Supabase, RDS, local…). Tables are created automatically.
DATABASE_URL=

# Dodo Payments: Dashboard → Developer → API keys
DODO_PAYMENTS_API_KEY=
# Dodo Payments: Dashboard → Developer → Webhooks → signing secret (whsec_…)
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode (default) or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product ID of the monthly subscription product (pdt_…)
DODO_PRODUCT_ID_MONTHLY=

# Public URL, e.g. https://shipproof.in (used for checkout return links and allowed origin)
APP_URL=
