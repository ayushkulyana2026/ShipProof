# Dodo Payments (Dashboard → Developer → API keys / Webhooks)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode (default) or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product id of the "Pro" product (pdt_...)
DODO_PRODUCT_ID_PRO=
# Optional: defaults to <site>/checkout/success
DODO_PAYMENTS_RETURN_URL=
